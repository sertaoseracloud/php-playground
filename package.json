{
  "name": "php-playground",
  "version": "1.11.0",
  "description": "DivergePHP: PHP, HTML e banco de dados no navegador, com acessibilidade para pessoas cegas, surdas e neurodivergentes",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun --collect.settings.chromeFlags=\"--no-sandbox\" --upload.target=filesystem --upload.outputDir=.lighthouseci",
    "badges": "node scripts/gerar-badges.mjs",
    "lint": "eslint .",
    "comuns": "node scripts/comuns.mjs",
    "comuns:copiar": "node scripts/comuns.mjs copiar",
    "comuns:comparar": "node scripts/comuns.mjs comparar"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@php-wasm/universal": "3.1.59",
    "@php-wasm/web": "3.1.59",
    "codemirror": "^6.0.2",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "^0.15.1",
    "@php-wasm/node": "3.1.59",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "@lhci/cli": {
      "basic-ftp": "^6.2.3",
      "extract-zip": "^2.0.1",
      "tmp": "^0.2.7",
      "uuid": "^14.0.3",
      "sprintf-js": "^1.1.3",
      "js-yaml": "^5.5.0",
      "inquirer": "^14.2.3",
      "proxy-agent": "^8.0.2",
      "lighthouse": "^13.5.0",
      "@puppeteer/browsers": "^3.2.5",
      "puppeteer-core": "^25.14.0"
    }
  }
}
